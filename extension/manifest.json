{
  "manifest_version": 3,
  "name": "Meeting AI Assistant",
  "version": "1.0.0",
  "description": "AI-powered meeting assistant",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content/content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}